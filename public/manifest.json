      "url": "/?view=weather",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Tank Dilution Calculator",
      "short_name": "Tank Calc",
      "description": "Calculate exact pesticide & water quantities per spray tank",
      "url": "/?view=dilution",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Farmer Simple View",
      "short_name": "Easy View",
      "description": "Simplified one-glance status in local language with voice advisory",
      "url": "/?view=farmer",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
