{
  "name": "AgroGuard - Smart Crop & Disease Diagnostic PWA",
  "short_name": "AgroGuard",
  "description": "AI-Powered Smart Crop Growth Stage, Disease Detection, Weather Advisories, and Farm Lifecycle Management Progressive Web App",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "window-controls-overlay"],
  "orientation": "any",
  "background_color": "#0a0f1d",
  "theme_color": "#059669",
  "lang": "en",
  "dir": "ltr",
  "categories": ["agriculture", "business", "productivity", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Crop Disease Scanner",
      "short_name": "Disease Scan",
      "description": "Instantly analyze corn leaf for disease or deficiencies",
